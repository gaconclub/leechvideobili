{
  "manifest_version": 3,
  "name": "Google Flow Auto-Bridge (Trung Tâm Điều Phối AI)",
  "version": "1.1.0",
  "description": "Cầu nối tự động tạo ảnh & video trên Google Flow (labs.google/fx) bằng tài khoản Chrome của bạn và gửi kết quả trực tiếp về Trung Tâm Điều Phối AI.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://labs.google/*",
    "https://*.googleusercontent.com/*",
    "https://*.googleapis.com/*",
    "https://storage.googleapis.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.run.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Google Flow Auto-Bridge"
  },
  "content_scripts": [
    {
      "matches": [
        "https://labs.google/fx/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}