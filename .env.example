# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI (or .env on local PC).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional AI providers for Derivative Studio script & image generation (configured in Secrets or .env)
OPENAI_API_KEY=""
META_API_KEY=""
META_BASE_URL="https://api.llama.com/compat/v1"
META_MODEL="Llama-4-Scout-17B-16E-Instruct-FP8"

# Optional free stock video providers for Derivative B-roll backgrounds
PEXELS_API_KEY=""
PIXABAY_API_KEY=""

# Optional self-hosted Muse2API bridge (OpenAI-compatible bridge for muse.ai)
MUSE2API_BASE_URL="http://127.0.0.1:18610"
MUSE2API_KEY=""
MUSE2API_IMAGE_TIMEOUT="240"
MUSE2API_VIDEO_TIMEOUT="600"
MUSE2API_CHAT_TIMEOUT="300"

# Local server port on PC (defaults to 6868 locally; AI Studio preview keeps 3000)
PORT="6868"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
